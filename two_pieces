<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>임신 D-day</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;600&display=swap');
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Noto Sans KR', sans-serif;
      background: transparent !important;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 60px 20px;
      gap: 30px;
    }

    .card {
      background: rgba(255, 255, 255, 0.8);
      backdrop-filter: blur(15px);
      -webkit-backdrop-filter: blur(15px);
      border-radius: 20px;
      padding: 30px 25px;
      width: 100%;
      max-width: 420px;
      border: 1px solid rgba(0,0,0,0.05);
      box-shadow: 0 4px 15px rgba(0,0,0,0.04);
    }

    .weeks-text {
      font-size: 1.1rem;
      color: #333;
      font-weight: 400;
      text-align: center;
      margin-bottom: 18px;
    }

    .weeks-number {
      font-weight: 600;
      color: #0984e3;
    }

    .progress-bar {
      width: 100%;
      height: 8px;
      background: rgba(0, 0, 0, 0.06);
      border-radius: 10px;
      overflow: hidden;
    }

    .progress-fill {
      height: 100%;
      background: #74b9ff;
      transition: width 0.4s ease;
    }

    .days-number {
      font-size: 3.5rem;
      font-weight: 600;
      color: #2d3436;
      text-align: center;
      margin-bottom: 15px;
    }

    .time-detail {
      display: flex;
      justify-content: center;
      gap: 16px;
      margin-bottom: 15px;
    }

    .time-unit {
      text-align: center;
    }

    .time-number {
      font-size: 1.5rem;
      font-weight: 500;
      color: #2d3436;
    }

    .time-label {
      font-size: 0.85rem;
      opacity: 0.7;
    }

    .days-text {
      font-size: 1rem;
      text-align: center;
      color: #636e72;
      font-weight: 400;
    }

    @media (prefers-color-scheme: dark) {
      body {
        background: transparent !important;
      }

      .card {
        background: rgba(30, 30, 30, 0.7);
        border: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
      }

      .weeks-text, .weeks-number, .days-number, .time-number {
        color: #ffffff;
      }

      .time-label, .days-text {
        color: rgba(255, 255, 255, 0.65);
      }

      .progress-bar {
        background: rgba(255, 255, 255, 0.08);
      }

      .progress-fill {
        background: linear-gradient(90deg, #74b9ff, #a0cfff);
      }
    }
  </style>
</head>
<body>
  <!-- 주차 정보 카드 -->
  <div class="card">
    <div class="weeks-text" id="weeksInfo">현재 임신 <span class="weeks-number">9</span>주 <span class="weeks-number">2</span>일</div>
    <div class="progress-bar">
      <div class="progress-fill" id="progressFill" style="width: 0%"></div>
    </div>
  </div>

  <!-- 디데이 카드 -->
  <div class="card">
    <div class="days-number" id="days">0</div>
    <div class="time-detail">
      <div class="time-unit">
        <div class="time-number" id="hours">00</div>
        <div class="time-label">시간</div>
      </div>
      <div class="time-unit">
        <div class="time-number" id="minutes">00</div>
        <div class="time-label">분</div>
      </div>
      <div class="time-unit">
        <div class="time-number" id="seconds">00</div>
        <div class="time-label">초</div>
      </div>
    </div>
    <div class="days-text" id="daysText">남았어요</div>
  </div>

  <script>
    function getQueryParam(key, def = '') {
      const params = new URLSearchParams(window.location.search);
      return params.get(key) || def;
    }

    const dueDateStr = getQueryParam('due', '2026-02-07');
    const targetDate = new Date(`${dueDateStr}T00:00:00+09:00`);
    const referenceDate = new Date(targetDate.getTime() - 280 * 24 * 60 * 60 * 1000);

    function updateCountdown() {
      const now = new Date(new Date().toLocaleString("en-US", { timeZone: "Asia/Seoul" }));
      const diff = targetDate - now;

      const totalDays = Math.floor((now - referenceDate) / (1000 * 60 * 60 * 24));
      const weeks = Math.floor(totalDays / 7);
      const days = totalDays % 7;

      document.getElementById('weeksInfo').innerHTML = days === 0
        ? `현재 임신 <span class="weeks-number">${weeks}</span>주`
        : `현재 임신 <span class="weeks-number">${weeks}</span>주 <span class="weeks-number">${days}</span>일`;

      const progress = Math.min((totalDays / 280) * 100, 100);
      document.getElementById('progressFill').style.width = progress + '%';

      if (diff > 0) {
        const daysLeft = Math.floor(diff / (1000 * 60 * 60 * 24));
        const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((diff % (1000 * 60)) / 1000);

        document.getElementById('days').textContent = daysLeft;
        document.getElementById('hours').textContent = String(hours).padStart(2, '0');
        document.getElementById('minutes').textContent = String(minutes).padStart(2, '0');
        document.getElementById('seconds').textContent = String(seconds).padStart(2, '0');
      } else {
        document.getElementById('days').textContent = '0';
        document.getElementById('hours').textContent = '00';
        document.getElementById('minutes').textContent = '00';
        document.getElementById('seconds').textContent = '00';
        document.getElementById('daysText').textContent = '축하해요!';
      }
    }

    updateCountdown();
    setInterval(updateCountdown, 1000);
  </script>
</body>
</html>
